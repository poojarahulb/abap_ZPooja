@Metadata.layer: #CORE
@Search.searchable: true //( adding a search field )
//@UI.headerInfo:{
//    typeName: 'Travel Details', //header text for detail page
//    typeNamePlural: 'Travel List' // header text for main list page
//}

//Header Info for Object Page

@UI.headerInfo: {
    typeName: 'Travel Details',
    typeNamePlural: 'Travel List',
    typeImageUrl: 'sap-icon://flight',
    title: {
        type: #STANDARD,
        value: 'TravelID'
    },
    description: {
        type: #STANDARD,
        value: 'Description'
    }
}

//selection variant
@UI.selectionVariant: [{
    qualifier: 'SV_All',
    text: 'All'
},
{
    qualifier: 'SV_Open',
    text: 'Open',
    filter: 'OverallStatus EQ "O" '
},
{
    qualifier: 'SV_Accepted',
    text: 'Accepted',
    filter: 'OverallStatus EQ "A" '
}
]

//presentation variant
@UI.presentationVariant: [{
    qualifier: 'PV_All',
    text: 'All',
    maxItems: 200,
    sortOrder: [{
        by: 'TravelID',
        direction: #DESC
    }],
    groupBy: [ 'AgencyID' ],
    requestAtLeast: [ 'TravelID', 'OverallStatus' ],
    visualizations: [{
        type: #AS_LINEITEM
    }],
    selectionFieldsQualifier: 'SV_All'
},
{
    qualifier: 'PV_Accepted',
    text: 'Accepted',
    maxItems: 200,
    sortOrder: [{
        by: 'CustomerName',
        direction: #ASC
    }],
    groupBy: [ 'CustomerID' ],
    requestAtLeast: [ 'TravelID', 'OverallStatus' ],
    visualizations: [{
        type: #AS_LINEITEM,
        qualifier: 'Acc'
    }],
    selectionFieldsQualifier: 'SV_Accepted'
}]

//selectionpresentationvariant
@UI.selectionPresentationVariant: [{
    qualifier: 'SPV_All',
    text: 'All',
    selectionVariantQualifier: 'SV_All',
    presentationVariantQualifier: 'PV_All'
},
{
    qualifier: 'SPV_Accepted',
    text: 'Accepted',
    selectionVariantQualifier: 'SV_Accepted',
    presentationVariantQualifier: 'PV_Accepted'
}]

annotate entity ZPC_TRAVEL_PROCESSOR_M with

{

  //Object page facets
  @UI.facet: [{
      purpose: #HEADER,
      position: 10,
      type: #DATAPOINT_REFERENCE,
      targetQualifier: 'TotalPrice'
      },
      {
      purpose: #HEADER,
      position: 30,
      type: #DATAPOINT_REFERENCE,
      targetQualifier: 'Status'
      },
      {
      purpose: #STANDARD, //1st tab in content section
      position: 10,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Travel'
      },
      {
      purpose: #STANDARD, 
      position: 20,// 2nd tab in content section
      type: #LINEITEM_REFERENCE,
      label: 'Bookings',
      targetElement: '_Booking'
      }
     ]

  @UI.lineItem: [{ position: 10 }]
  @Search.defaultSearchElement: true //Search if anyone enters data for this field
  @Search.fuzzinessThreshold: 0.7
  @UI.identification: [{ position: 10 }]
  TravelID;

  @UI.lineItem: [{ position: 20 }] // show column for this field
  @UI.selectionField: [{  position: 10}] // add filter for this field
  @Search.defaultSearchElement: true //Search if anyone enters data for this field
  @Consumption.valueHelpDefinition: [{ entity: {
        name: '/DMO/I_Agency',
        element: 'AgencyID'
        } }]
  @UI.identification: [{ position: 20 }]
  AgencyID;
  // AgencyName;

  @UI.lineItem: [{ position: 30 ,qualifier: 'Acc'}]
  @UI.selectionField: [{  position: 20}]
  @Search.defaultSearchElement: true //Search if anyone enters data for this field
  @Consumption.valueHelpDefinition: [{ entity: {
       name: '/DMO/I_Customer',
       element: 'CustomerID'
       } }]
  @UI.identification: [{ position: 30 }]
  CustomerID;
  // CustomerName;

  @UI.lineItem: [ { position: 40, qualifier: 'Acc' } ]
  @UI.identification: [{ position: 40 }]
  BeginDate;

  @UI.lineItem: [ { position: 50 } ]
  @UI.identification: [{ position: 50 }]
  EndDate;

  // BookingFee;
  
  
  // data point to define the qualifier for facet above
  @UI: { dataPoint: { qualifier: 'TotalPrice', title: 'Total Price' },
         lineItem:  [ { position: 60 } ] }
  @UI.identification: [{ position: 60 }]
  //  @Consumption.valueHelpDefinition: [{ entity: {
  //       name: 'I_Currency',
  //       element: 'Currency'
  //       } }]
  TotalPrice;
  
  @UI.identification: [{ position: 70 }]
  CurrencyCode;

  // Here multiple annotation items are combined to a single line using :
  @UI: { lineItem: [{ position: 70 }],
  textArrangement: #TEXT_ONLY, //( remove status code ),
  selectionField: [{  position: 30}]}
  @Search.defaultSearchElement: true //Search if anyone enters data for this field
  @Consumption.valueHelpDefinition: [{ entity: {
       name: '/DMO/I_Overall_Status_VH',
       element: 'OverallStatus'
       } }]
  @UI.identification: [{ position: 80 }]
  // data point to define the qualifier for facet above
  @UI.dataPoint:
  {
    qualifier: 'Status',
    title: 'Status'
  }
  OverallStatus;
  
  
  // OverallStatusText;
  
  
  @UI.identification: [{ position: 90 }]
  Description;
  // LastChangedAt;
  
}